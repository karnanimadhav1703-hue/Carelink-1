rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY hackathon test mode. Anyone can read/write before this expiry.
    // Use fictional data only. Replace with ownership/link rules before launch.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 11, 21);
    }
  }
}
